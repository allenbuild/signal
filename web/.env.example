# Server-only. Both values are required to enable the Anthropic planner.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Server-only fixed Discord webhook. Never expose this as NEXT_PUBLIC_*.
DISCORD_WEBHOOK_URL=

# Comma-separated exact origins in addition to the same-origin website.
SIGNAL_ALLOWED_ORIGINS=

# Public release artifact URL rendered by the server-side download page.
SIGNAL_DOWNLOAD_URL=
SIGNAL_RELEASE_VERSION=
SIGNAL_RELEASE_COMMIT=
SIGNAL_RELEASE_SHA256=
SIGNAL_RELEASE_ARCHITECTURE=
SIGNAL_SIGNING_STATUS=
SIGNAL_NOTARIZATION_STATUS=
