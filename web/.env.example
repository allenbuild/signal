# Server-only planner configuration. Leave blank unless the provider is enabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Server-only typed integration credential.
DISCORD_WEBHOOK_URL=

# Public canonical HTTPS origin. Never place a secret in NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=

# Public release metadata. Populate only after artifact verification.
NEXT_PUBLIC_RELEASE_DOWNLOAD_URL=
NEXT_PUBLIC_RELEASE_VERSION=
NEXT_PUBLIC_RELEASE_COMMIT=
NEXT_PUBLIC_RELEASE_SHA256=
NEXT_PUBLIC_RELEASE_MINIMUM_MACOS=
NEXT_PUBLIC_RELEASE_SIGNING_STATUS=
NEXT_PUBLIC_RELEASE_FILENAME=

# Optional existing target for Playwright smoke tests.
PLAYWRIGHT_BASE_URL=
BASE_URL=
CI=

# D1 credentials do not belong in this file. The platform injects binding DB.
