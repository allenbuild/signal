{
  "name": "signal-extension",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/smoke-extension.mjs",
    "test:watch": "vitest",
    "package": "pnpm build && bash scripts/package.sh && pnpm test:package",
    "test:package": "node scripts/verify-package.mjs",
    "verify": "pnpm lint && pnpm test && pnpm typecheck && pnpm package"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.0",
    "@types/chrome": "^0.1.32",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.10"
  }
}
